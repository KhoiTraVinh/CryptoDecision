# ── Environment (chứa credentials, không commit) ─────────────────────────────
.env

# ── .NET build artifacts ─────────────────────────────────────────────────────
src/*/bin/
src/*/obj/

# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
src/*/*.egg-info/
src/*/.venv/
src/*/venv/

# ── Mobile / Capacitor ────────────────────────────────────────────────────────
mobile/node_modules/
mobile/android/.gradle/
mobile/android/app/build/
mobile/android/local.properties
# Capacitor auto-generated assets (regenerated by `npm run sync`)
mobile/android/app/src/main/assets/capacitor.config.json
mobile/android/app/src/main/assets/capacitor.plugins.json
mobile/android/app/src/main/assets/public/

# ── APK build outputs ─────────────────────────────────────────────────────────
# CryptoDecision-debug.apk và dashboard/app.apk được giữ trong repo
# để nginx có thể serve và người dùng có thể download.
# Chỉ bỏ qua APK trùng lặp trong mobile/:
mobile/CryptoDecision-latest.apk

# ── IDE / Editor ──────────────────────────────────────────────────────────────
.vscode/
.idea/
*.suo
*.user

# ── OS ────────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
