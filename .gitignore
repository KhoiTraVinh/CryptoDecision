# ── Environment (chứa credentials, không commit) ─────────────────────────────
.env

# ── .NET build artifacts ─────────────────────────────────────────────────────
src/*/bin/
src/*/obj/

# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
src/*/*.egg-info/
src/*/.venv/
src/*/venv/

# ── IDE / Editor ──────────────────────────────────────────────────────────────
.vscode/
.idea/
*.suo
*.user

# ── OS ────────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# pg_dump output — data, not code. Regenerate with the pg_dump in the runbook.
seed.sql

# ── Mobile app ────────────────────────────────────────────────────────────────
# Kept out of the repo entirely, operator's call 2026-11-13. Note what this also
# keeps out: mobile/www/config.js carries the tunnel hostname and the server's
# egress IP, and a built APK is a signed artifact rather than source.
/mobile/

