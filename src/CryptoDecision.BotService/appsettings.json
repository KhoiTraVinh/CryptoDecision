{
    "Serilog": {
        "MinimumLevel": {
            "Default": "Information",
            "Override": {
                "Microsoft": "Warning",
                "System": "Warning"
            }
        },
        "WriteTo": [
            {
                "Name": "Console",
                "Args": {
                    "formatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact"
                }
            }
        ],
        "Enrich": [
            "FromLogContext",
            "WithMachineName",
            "WithEnvironmentName"
        ]
    },
    "ConnectionStrings": {
        "Postgres": "Host=postgres;Port=5432;Database=crypto;Username=crypto;Password=crypto;Pooling=true;MinPoolSize=2;MaxPoolSize=20;"
    },
    "FlowStrategy": {
        "Signal": {
            "SignalBars": 4,
            "BaselineBars": 44,
            "EnterZ": 1.0,
            "MinAgreeingVenues": 2,
            "MinVenueVolumeFractionOfMedian": 0.20,
            "MinVenueVolumeUsd": 25000,
            "MinVenueTrades": 50,
            "MaxConcentration": 0.35,
            "MaxDispersionBps": 25.0
        },
        "MaxBarAge": "00:35:00",
        "AtrLookbackMinutes": 240,
        "StopAtrMultiple": 1.5,
        "TargetRiskMultiple": 2.0,
        "RoundTripFeeRate": 0.001,
        "MinRewardRisk": 1.2
    },
    "Okx": {
        "BaseUrl": "https://www.okx.com",
        "DemoTrading": true,
        "Leverage": 3,
        "MarginMode": "isolated",
        "EnableLiveTrading": false,
        "MaxOrderNotionalUsd": 100,
        "MinOrderNotionalUsd": 5,
        "FillPollAttempts": 12,
        "FillPollDelayMs": 500,
        "TimeoutSeconds": 10
    }
}