    "SignalLabeling": {
        "Enabled": true,
        "Symbol": "SOLUSDT",
        "Interval": "00:30:00",
        "HorizonMinutes": 720,
        "LabelVersion": 1
    },
    "GateRetrieval": {
        "Enabled": true,
        "Examples": 5,
        "MinDecidedSignals": 20
    },
    "Okx": {
        "BaseUrl": "https://www.okx.com",
        "DemoTrading": true,
        "Leverage": 3,
        "MarginMode": "isolated",
        "EnableLiveTrading": false,
        "MaxOrderNotionalUsd": 100,
        "MinOrderNotionalUsd": 5,
        "FillPollAttempts": 12,
        "FillPollDelayMs": 500,
