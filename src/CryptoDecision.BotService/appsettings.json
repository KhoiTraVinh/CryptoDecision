{
    "Serilog": {
        "MinimumLevel": {
            "Default": "Information",
            "Override": {
                "Microsoft": "Warning",
                "System": "Warning"
            }
        },
        "WriteTo": [
            {
                "Name": "Console",
                "Args": {
                    "formatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact"
                }
            }
        ],
        "Enrich": [
            "FromLogContext",
            "WithMachineName",
            "WithEnvironmentName"
        ]
    },
    "ConnectionStrings": {
        "Postgres": "Host=postgres;Port=5432;Database=crypto;Username=crypto;Password=crypto;Pooling=true;MinPoolSize=2;MaxPoolSize=20;"
    },
    "FlowStrategy": {
        "Signal": {
            "SignalBars": 4,
            "BaselineBars": 44,
            "EnterZ": 1.0,
            "MinAgreeingVenues": 2,
            "MinVenueVolumeFractionOfMedian": 0.20,
            "MinVenueVolumeUsd": 25000,
            "MinVenueTrades": 50,
            "MaxConcentration": 0.35,
            "MaxDispersionBps": 0.0,
            "VenueAgreementZ": 1.5,
            "SufficientVenue": "BINANCE",

            "EntryMode": "FlowRatio",
            "RatioMinimum": 2.1,
            "RatioMinVolumeUsd": 3000000,
            "RatioHighVolumeUsd": 20000000,
            "RatioSettleMinutes": 3,
            "ReversalDropPct": 0.60,
            "ReversalBars": 2,
            "ReversalBarsShort": 1,
            "ReversalRisePct": 1.00,
            "ReversalLongOnly": false,

            "MinAbsOfi": 0.30,
            "MagnitudeBars": 1
        },
        "MaxBarAge": "00:35:00",
        "AtrLookbackMinutes": 240,
        "StopAtrMultiple": 1.5,
        "TargetRiskMultiple": 2.0,
        "RoundTripFeeRate": 0.001,

        "UseRangeGeometry": false,
        "RangeLookbackMinutes": 120,
        "MinRewardRisk": 0.5,
        "MinStopPct": 0.020,
        "UseFlowOfiExit": true,
        "FlowOfiBars": 10,

        "EntryPullbackAtr": 0.0
    },
    "DipStrategy": {
        "Name": "CANDLE_REVERSAL",
        "Signal": {
            "EntryMode": "CandleReversal",
            "ReversalDropPct": 0.60,
            "ReversalBars": 2,
            "ReversalRisePct": 1.00,
            "ReversalBarsShort": 1,
            "ReversalLongOnly": false
        },
        "MaxBarAge": "00:35:00",
        "AtrLookbackMinutes": 240,
        "StopAtrMultiple": 1.5,
        "TargetRiskMultiple": 2.0,
        "RoundTripFeeRate": 0.001,
        "UseRangeGeometry": false,
        "MinRewardRisk": 0.5,
        "MinStopPct": 0.020,
        "UseFlowOfiExit": true,
        "FlowOfiBars": 10,
        "EntryPullbackAtr": 0.0
