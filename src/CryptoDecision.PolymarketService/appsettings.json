{
  "Polymarket": {
    "DryRun": true,

    "PrivateKey": "",
    "SignatureType": 2,
    "FunderAddress": "",

    "StakeUsd": 0.20,
    "MaxDailyUsd": 15,

    "EntryPrices": [ 0.03, 0.01 ],
    "MinAskPrice": 0.01,
    "MinVolumeUsd": 50000,
    "Games": [ "Counter-Strike", "LoL", "Dota 2", "Valorant" ],

    "MaxHoursToEnd": 24,
    "MinMinutesToEnd": 2,

    "ScanIntervalSeconds": 20,
    "MarketRefreshSeconds": 120,
    "PositionRefreshSeconds": 300
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "formatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact"
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithEnvironmentName" ]
  }
}
