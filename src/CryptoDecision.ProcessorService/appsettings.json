{
  "ConnectionStrings": {
    "Postgres": "Host=postgres;Port=5432;Database=crypto;Username=crypto;Password=crypto;Pooling=true;MinPoolSize=5;MaxPoolSize=50;"
  },
  "Kafka": {
    "BootstrapServers": "kafka:9092",
    "GroupId": "processor-group",
    "TradeTopics": [
      "binance.trade.solusdt",
      "okx.trade.solusdt",
      "bybit.trade.solusdt"
    ],
    "KlineTopics": ["binance.kline.1m.solusdt"]
  },
  "Feature": {
    "Symbols": ["SOLUSDT"],
    "AggregationInterval": "00:05:00"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System":    "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "formatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact"
        }
      }
    ],
    "Enrich": ["FromLogContext", "WithMachineName", "WithEnvironmentName"]
  }
}
