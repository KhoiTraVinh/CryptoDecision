{
  "ConnectionStrings": {
    "Postgres": "Host=postgres;Port=5432;Database=crypto;Username=crypto;Password=crypto;Pooling=true;MinPoolSize=5;MaxPoolSize=50;"
  },
  "Kafka": {
    "BootstrapServers": "kafka:9092",
    "GroupId": "processor-group",
    "TradeTopics": [
      "binance.trade.btcusdt",  "binance.trade.ethusdt",
      "okx.trade.btcusdt",      "okx.trade.ethusdt",
      "bybit.trade.btcusdt",    "bybit.trade.ethusdt"
    ],
    "KlineTopics": ["binance.kline.1m.btcusdt", "binance.kline.1m.ethusdt"]
  },
  "Feature": {
    "Symbols": ["BTCUSDT", "ETHUSDT"],
    "AggregationInterval": "00:05:00"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System":    "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "formatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact"
        }
      }
    ],
    "Enrich": ["FromLogContext", "WithMachineName", "WithEnvironmentName"]
  }
}
