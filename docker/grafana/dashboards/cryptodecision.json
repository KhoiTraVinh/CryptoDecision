{
  "title": "CryptoDecision Overview",
  "uid": "cryptodecision-main",
  "schemaVersion": 38,
  "version": 2,
  "refresh": "30s",
  "time": { "from": "now-3h", "to": "now" },
  "panels": [
    {
      "id": 1, "type": "stat", "title": "Trades Ingested (last 5m)",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "targets": [{
        "datasource": { "uid": "prometheus" },
        "expr": "sum(rate(trades_ingested_trades_total[5m])) * 60",
        "legendFormat": "trades/min"
      }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" },
      "fieldConfig": { "defaults": { "unit": "short", "thresholds": { "steps": [
        { "color": "green", "value": null },
        { "color": "yellow", "value": 1000 },
        { "color": "red", "value": 5000 }
      ]}}}
    },
    {
      "id": 2, "type": "stat", "title": "Trades Persisted (last 5m)",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "targets": [{
        "datasource": { "uid": "prometheus" },
        "expr": "sum(rate(trades_persisted_trades_total[5m])) * 60",
        "legendFormat": "trades/min"
      }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" },
      "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "thresholds" },
        "thresholds": { "steps": [{ "color": "green", "value": null }]}}}
    },
    {
      "id": 3, "type": "stat", "title": "Duplicates Skipped (last 5m)",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "targets": [{
        "datasource": { "uid": "prometheus" },
        "expr": "sum(rate(trades_duplicates_skipped_trades_total[5m])) * 60",
        "legendFormat": "dups/min"
      }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" },
      "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "thresholds" },
        "thresholds": { "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 1 }]}}}
    },
    {
      "id": 4, "type": "stat", "title": "Features Computed (last 1h)",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "targets": [{
        "datasource": { "uid": "prometheus" },
        "expr": "sum(increase(features_computed_rows_total[1h]))",
        "legendFormat": "features/hour"
      }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": { "defaults": { "unit": "short" } }
    },
    {
      "id": 5, "type": "timeseries", "title": "Trades per Minute by Exchange",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "targets": [{
        "datasource": { "uid": "prometheus" },
        "expr": "sum by(exchange) (rate(trades_ingested_trades_total[1m])) * 60",
        "legendFormat": "{{exchange}}"
      }],
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "lineWidth": 2 } } }
    },
    {
      "id": 6, "type": "timeseries", "title": "Kafka Batch Size (p95)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "targets": [{
        "datasource": { "uid": "prometheus" },
        "expr": "histogram_quantile(0.95, sum by(le, exchange) (rate(trades_batch_size_trades_bucket[5m])))",
        "legendFormat": "p95 {{exchange}}"
      }],
      "fieldConfig": { "defaults": { "unit": "short" } }
    },
    {
      "id": 7, "type": "timeseries", "title": "Channel Depth",
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 12 },
      "targets": [
        {
          "datasource": { "uid": "prometheus" },
          "expr": "channel_depth_trades",
          "legendFormat": "trade channel"
        },
        {
          "datasource": { "uid": "prometheus" },
          "expr": "channel_depth_klines_trades",
          "legendFormat": "kline channel"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short" },
        "overrides": [{ "matcher": { "id": "byName", "options": "trade channel" },
          "properties": [{ "id": "thresholds", "value": { "steps": [
            { "color": "green", "value": null },
            { "color": "yellow", "value": 10000 },
            { "color": "red", "value": 40000 }
          ]}}]}]
      }
    },
    {
      "id": 8, "type": "timeseries", "title": "Bulk Insert Duration (ms)",
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 12 },
      "targets": [{
        "datasource": { "uid": "prometheus" },
        "expr": "histogram_quantile(0.99, sum by(le) (rate(bulk_insert_duration_ms_milliseconds_bucket[5m])))",
        "legendFormat": "p99"
      }, {
        "datasource": { "uid": "prometheus" },
        "expr": "histogram_quantile(0.50, sum by(le) (rate(bulk_insert_duration_ms_milliseconds_bucket[5m])))",
        "legendFormat": "p50"
      }],
      "fieldConfig": { "defaults": { "unit": "ms" } }
    },
    {
      "id": 9, "type": "timeseries", "title": "API Request Latency (ms)",
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 18 },
      "targets": [{
        "datasource": { "uid": "prometheus" },
        "expr": "histogram_quantile(0.99, sum by(le, http_route) (rate(http_server_request_duration_seconds_bucket{job=\"api-service\"}[5m]))) * 1000",
        "legendFormat": "p99 {{http_route}}"
      }],
      "fieldConfig": { "defaults": { "unit": "ms" } }
    },
    {
      "id": 10, "type": "timeseries", "title": ".NET Heap Size (MB)",
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 18 },
      "targets": [{
        "datasource": { "uid": "prometheus" },
        "expr": "dotnet_gc_last_collection_heap_size_bytes / 1048576",
        "legendFormat": "{{job}} heap MB"
      }],
      "fieldConfig": { "defaults": { "unit": "decmbytes" } }
    },
    {
      "id": 11, "type": "timeseries", "title": "Predictions by Direction",
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 24 },
      "targets": [{
        "datasource": { "uid": "prometheus" },
        "expr": "sum by(direction, symbol) (rate(predictions_generated_total[5m])) * 300",
        "legendFormat": "{{symbol}} {{direction}}"
      }],
      "fieldConfig": { "defaults": { "unit": "short" } }
    },
    {
      "id": 12, "type": "gauge", "title": "Model Confidence by Symbol",
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 24 },
      "targets": [{
        "datasource": { "uid": "prometheus" },
        "expr": "model_confidence",
        "legendFormat": "{{symbol}}"
      }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "minVizWidth": 75 },
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1,
        "thresholds": { "steps": [
          { "color": "red", "value": null },
          { "color": "yellow", "value": 0.5 },
          { "color": "green", "value": 0.7 }
        ]}}}
    }
  ]
}
